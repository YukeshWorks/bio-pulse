# Copy to .env for local pipeline runs (never commit .env). In GitHub, set these as
# Actions secrets (Settings → Secrets and variables → Actions). All are optional.

# NCBI E-utilities: raises PubMed rate limit from 3 to 10 requests/s. https://account.ncbi.nlm.nih.gov/settings/
NCBI_API_KEY=
# Contact e-mail sent to NCBI with E-utilities requests (NCBI etiquette; kept out of the repository).
NCBI_EMAIL=

# Optional AI summaries via the Claude API (https://console.anthropic.com/). A Claude.ai Pro/Max
# subscription does NOT include API credits. Without a key, deterministic summaries are used.
ANTHROPIC_API_KEY=
# BIOPULSE_AI_MODEL=claude-opus-5-5
# BIOPULSE_AI_EFFORT=medium
# BIOPULSE_AI_DISABLE=false

# European Patent Office Open Patent Services (free registration: https://developers.epo.org/).
EPO_OPS_KEY=
EPO_OPS_SECRET=

# Optional official company press-release feeds (JSON array, https only):
# BIOPULSE_COMPANY_FEEDS=[{"name":"Example Bio newsroom","url":"https://example.com/news/rss.xml"}]

# Tuning (defaults shown)
# BIOPULSE_LOOKBACK_DAYS=2
# BIOPULSE_PATENT_LOOKBACK_DAYS=7
# BIOPULSE_MAX_RECORDS=200
# BIOPULSE_VERIFY_URLS=true
# BIOPULSE_DATA_DIR=public/data
