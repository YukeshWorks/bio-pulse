{
  "name": "biopulse",
  "private": true,
  "version": "1.0.0",
  "description": "BioPulse – Biotechnology Daily Intelligence. Evidence-labelled daily monitoring of biotechnology research, preprints, clinical trials, regulatory news and patents.",
  "type": "module",
  "license": "BSL-1.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "vite",
    "dev:demo": "VITE_DATA_MODE=demo vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e-responsive.mjs",
    "pipeline": "node --env-file-if-exists=.env --import tsx pipeline/run.ts",
    "validate:data": "tsx pipeline/validate-data.ts",
    "verify:dist": "node scripts/verify-dist.mjs",
    "demo:generate": "tsx scripts/generate-demo.ts",
    "test:all": "npm run typecheck && npm test && npm run build && npm run verify:dist && npm run test:e2e",
    "feed": "tsx pipeline/build-feed.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fast-xml-parser": "^5.12.1",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
